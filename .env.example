# 공개 클라이언트 설정. 실제 웹 설정은 apps/web/.env.local에 보관합니다.
VITE_API_BASE_URL=/api
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_KAKAO_MAP_JS_KEY=
VITE_MAP_ORIGIN=

# 로컬 Supabase의 카카오 로그인 설정. 실제 값은 같은 폴더의 .env에 입력합니다.
# 아래 두 값은 카카오디벨로퍼스의 같은 REST API 키 상세 설정에서 확인합니다.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=""
